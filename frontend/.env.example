# Explicitly choose the deterministic demo adapter or the authenticated backend.
VITE_USE_MOCK_API=false

# Public URL of the VideoMind FastAPI service.
VITE_API_BASE_URL=http://localhost:8000

# Public Supabase browser configuration. Never place service-role credentials here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
