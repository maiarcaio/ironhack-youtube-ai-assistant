{
  "openapi": "3.1.0",
  "info": {
    "title": "VideoMind AI API",
    "description": "Backend API for the multimodal YouTube RAG assistant.",
    "version": "0.1.0"
  },
  "paths": {
    "/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat",
        "description": "Legacy endpoint for testing.",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat V1",
        "description": "Answer questions using evidence from the selected video.\n\nLocal development only until authentication is implemented.",
        "operationId": "chat_v1_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatV1Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatV1Response"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/stream": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat Stream",
        "description": "Stream agent responses using Server-Sent Events.\n\nLocal development only until authentication is implemented.",
        "operationId": "chat_stream_api_v1_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatV1Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/ingest": {
      "post": {
        "tags": [
          "Videos"
        ],
        "summary": "Ingest Video",
        "description": "Receive a video ingestion request.\n\nThe ingestion pipeline will be connected later.",
        "operationId": "ingest_video_api_v1_videos_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestVideoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestVideoResponse"
                }
              }
            }
          },
          "501": {
            "description": "Ingestion not implemented yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/status": {
      "get": {
        "tags": [
          "Videos"
        ],
        "summary": "Get Video Status",
        "description": "Get the ingestion status of a video.",
        "operationId": "get_video_status_api_v1_videos__video_id__status_get",
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoStatusResponse"
                }
              }
            }
          },
          "501": {
            "description": "Status lookup not implemented yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos": {
      "get": {
        "tags": [
          "Videos"
        ],
        "summary": "List Videos",
        "description": "List videos belonging to the authenticated user.",
        "operationId": "list_videos_api_v1_videos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoListResponse"
                }
              }
            }
          },
          "501": {
            "description": "Library not implemented yet"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatSource": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "start_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Seconds"
          },
          "end_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Seconds"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "transcript",
              "frame"
            ],
            "title": "Source Type",
            "default": "transcript"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "excerpt"
        ],
        "title": "ChatSource"
      },
      "ChatV1Request": {
        "properties": {
          "video_id": {
            "type": "string",
            "minLength": 1,
            "title": "Video Id"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "analysis_mode": {
            "type": "string",
            "enum": [
              "auto",
              "deep"
            ],
            "title": "Analysis Mode",
            "default": "auto"
          },
          "response_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Language"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "message"
        ],
        "title": "ChatV1Request"
      },
      "ChatV1Response": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSource"
            },
            "type": "array",
            "title": "Sources"
          },
          "insufficient_evidence": {
            "type": "boolean",
            "title": "Insufficient Evidence"
          },
          "model_used": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Used"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "thread_id",
          "answer",
          "sources",
          "insufficient_evidence"
        ],
        "title": "ChatV1Response"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestVideoRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "IngestVideoRequest"
      },
      "IngestVideoResponse": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "status"
        ],
        "title": "IngestVideoResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VideoItem": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "title",
          "status"
        ],
        "title": "VideoItem"
      },
      "VideoListResponse": {
        "properties": {
          "videos": {
            "items": {
              "$ref": "#/components/schemas/VideoItem"
            },
            "type": "array",
            "title": "Videos"
          }
        },
        "type": "object",
        "required": [
          "videos"
        ],
        "title": "VideoListResponse"
      },
      "VideoStatusResponse": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "status"
        ],
        "title": "VideoStatusResponse"
      }
    }
  }
}